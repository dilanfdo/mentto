{
  "expo": {
    "name": "Mentto",
    "slug": "mentto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nexusdigitallabs.mentto"
    },
    "android": {
      "package": "app.nexusdigitallabs.mentto",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans_400Regular.ttf",
            "./assets/fonts/PlusJakartaSans_500Medium.ttf",
            "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E0E15",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/withReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAccentColor"
    ],
    "scheme": "mentto",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F6F6FA",
    "primaryColor": "#4F46E5"
  }
}
