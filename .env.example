# Build-time settings. Copy to .env.local (git-ignored) and change only what you need;
# everything has a working default in src/lib/config.ts.

# RevenueCat public SDK key for Android (starts with goog_). Public by design; never put a
# secret sk_ key in any EXPO_PUBLIC_ variable. Defaults to Mentto's production key.
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Debug builds simulate Pro purchases (no store, nothing charged). Set to "store" to test real
# Google Play billing from a debug build. Release builds always use the store.
EXPO_PUBLIC_BILLING_MODE=
